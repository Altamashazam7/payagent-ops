APP_NAME=PayAgent Ops API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://localhost:5432/payagent_ops
DATABASE_ECHO=false
API_V1_PREFIX=/api/v1
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT_SECONDS=15
PAYPAL_RETRY_ATTEMPTS=3
PAYPAL_RETRY_MIN_WAIT_SECONDS=0.25
PAYPAL_RETRY_MAX_WAIT_SECONDS=4
PAYPAL_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
PAYPAL_CIRCUIT_BREAKER_RESET_SECONDS=30